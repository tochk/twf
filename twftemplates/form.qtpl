{% import "github.com/tochk/twf/datastruct" %}

{% func Form(link, content string) %}
<div class="form-container">
    <form action="{%s link %}" method="post">
        {%s= content %}
        <input type="submit" class="btn btn-primary" value="Submit">
    </form>
</div>
{% endfunc %}

{% func MultipartForm(link, content string) %}
<div class="form-container">
    <form enctype="multipart/form-data" action="{%s link %}" method="post">
        {%s= content %}
        <input type="submit" class="btn btn-primary" value="Submit">
    </form>
</div>
{% endfunc %}

{% func FormItem(field datastruct.Field) %}
<div class="form-group">
    <label for="{%s field.Name %}">{%s field.Title %}</label>
    <input {% if field.Disabled %} disabled {% endif %} type="{%s field.Type %}" {% if field.Required %} required {% endif %} name="{%s field.Name %}" {% if field.Step != "" %} step="{%s field.Step %}" {% endif %} class="form-control"
           id="{%s field.Name %}" placeholder="{%s field.Placeholder %}"  value="{%v field.Value %}">
</div>
{% endfunc %}

{% func FormItemTextarea(field datastruct.Field) %}
<div class="form-group">
    <label for="{%s field.Name %}">{%s field.Title %}</label>
    <textarea {% if field.Disabled %} disabled {% endif %} {% if field.Required %} required {% endif %} name="{%s field.Name %}" rows="10" class="form-control" id="{%s field.Name %}" placeholder="{%s field.Placeholder %}">{%v field.Value %}</textarea>
</div>
{% endfunc %}

{% func FormItemSelect(field datastruct.Field, kvs []datastruct.FkKV, selectedID interface{}) %}
<div class="form-group">
    <label for="{%s field.Name %}">{%s field.Title %}</label>
    <select {% if field.Disabled %} disabled {% endif %} {% if field.Required %} required {% endif %} class="form-control" id="{%s field.Name %}" name="{%s field.Name %}">
            <option value=""></option>
            {% for _, e := range kvs %}
            <option {% if selectedID != nil %} {% if selectedID == e.ID %} selected {% endif %} {% endif %} value="{%v e.ID %}">{%v e.Name %}</option>
            {% endfor %}
    </select>
</div>
{% endfunc %}

{% func FormItemCheckbox(field datastruct.Field) %}
<div class="form-group">
    <div class="checkbox">
        <label for="{%s field.Name %}">
            <input type="checkbox" {% if field.Disabled %} disabled {% endif %} name="{%s field.Name %}" {% if field.Value == "true" %} checked {% endif %} value="on" id="{%s field.Name %}">
            {%s field.Title %}
        </label>
    </div>
</div>
{% endfunc %}